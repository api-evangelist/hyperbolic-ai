  "info": {
    "_postman_id": "14311510-02c6-4eea-aa57-a2b884de7578",
    "name": "Hyperbolic Audio Generation Chat Completions API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Convert text to natural-sounding speech using audio models hosted by Hyperbolic — Melo TTS (sunset) and Whisper (coming soon). Returns base64-encoded audio. Pricing from $0.001 per 1000 characters.\n\n\nContact Support:\n Name: Hyperbolic Support\n Email: support@hyperbolic.ai",
      "type": "text/plain"
    }
